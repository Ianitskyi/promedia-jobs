# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only — NEVER prefix with NEXT_PUBLIC_,
# never import it from client components, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app, used to build ticket URLs embedded in
# QR codes and emails (e.g. https://events.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email provider. Leave unset to use the console provider, which logs
# emails server-side instead of sending them — the default for local
# development. Set to "resend" to send via the Resend HTTP API.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="ProMedia Events <tickets@example.com>"
